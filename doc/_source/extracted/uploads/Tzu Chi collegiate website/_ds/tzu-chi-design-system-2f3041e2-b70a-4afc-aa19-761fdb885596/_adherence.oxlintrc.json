{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "ui_kits/foundation-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Palatino Linotype|STKaiti|Microsoft JhengHei|Spectral|Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Palatino Linotype, STKaiti, Microsoft JhengHei, Spectral, Source Sans 3."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aphorism'] > JSXAttribute > JSXIdentifier[name!=/^(?:zh|en|by|source|tone|style|key|ref|className|style|children)$/]",
        "message": "<Aphorism> doesn't accept that prop. Declared props: zh, en, by, source, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aphorism'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|inverse)$/]",
        "message": "<Aphorism> tone must be one of 'light' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|type|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, type, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|onNavy|ghostLight)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'onNavy' | 'ghostLight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|interactive|padded|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, interactive, padded, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|zh|tone|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, zh, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|subtle|onInverse)$/]",
        "message": "<Eyebrow> tone must be one of 'accent' | 'subtle' | 'onInverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LotusMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|style|key|ref|className|style|children)$/]",
        "message": "<LotusMark> doesn't accept that prop. Declared props: size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LotusMark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|sky)$/]",
        "message": "<LotusMark> tone must be one of 'navy' | 'sky'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MissionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|zh|children|style|key|ref|className|style|children)$/]",
        "message": "<MissionCard> doesn't accept that prop. Declared props: icon, title, zh, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Roofline'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|color|style|key|ref|className|style|children)$/]",
        "message": "<Roofline> doesn't accept that prop. Declared props: width, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|style|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|appearance|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, appearance, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|sky|gold)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'accent' | 'sky' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='appearance'] > Literal[value!=/^(?:soft|outline)$/]",
        "message": "<Tag> appearance must be one of 'soft' | 'outline'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
