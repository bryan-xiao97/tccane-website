# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini

# Dependencies (none currently, but guard against future tooling)
node_modules/

# Logs
*.log

# Photo masters (~33 MB of full-resolution camera originals).
# Only the derivatives built by tools/build-photos.py are committed; the
# masters are archived in the chapter Drive. Keeping them out of history
# matters — git never forgets a 33 MB blob, and one master carries GPS
# coordinates for a private home.
assets/photos/_originals/

# SDD scratch
references/progress/

# Middleware (Cloudflare Pages Functions) local tooling
.dev.vars
.wrangler/
dist/

# One-time local Google OAuth setup artifacts
.owner-setup-*

.env
.env.*
!.env.example

.dev.vars
.dev.vars.*
!.dev.vars.example
